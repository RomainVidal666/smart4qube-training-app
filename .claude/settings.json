{
  "permissions": {
    "deny": [
      "Read(./.claude/hooks/**)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__git__git_commit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/check-git-tool.ps1"
          }
        ]
      }
    ]
  }
}
